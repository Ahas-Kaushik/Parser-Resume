# ========================================
# Fetch Ya Job - Backend Environment Variables
# ========================================

# ── App ──────────────────────────────────
DEBUG=false
APP_NAME=Fetch Ya Job

# ── Database ─────────────────────────────
# Dev:
DATABASE_URL=sqlite:///./app.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/fetchyajob

# ── Security ─────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRATION_DAYS=7

# ── CORS ─────────────────────────────────
# Set to your Vercel frontend URL in production
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── Frontend URL (for OAuth redirects) ───
# Dev:
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://your-app.vercel.app

# ── Google OAuth ─��────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Dev callback:
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# Production callback:
# GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/oauth/google/callback

# ── GitHub OAuth ──────────────────────────
# Get from: https://github.com/settings/developers → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Dev callback:
GITHUB_REDIRECT_URI=http://localhost:8000/oauth/github/callback
# Production callback:
# GITHUB_REDIRECT_URI=https://your-backend.onrender.com/oauth/github/callback

# ── Email (optional) ─────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Storage ───────────────────────────────
UPLOAD_DIR=./storage
MAX_FILE_SIZE=10485760