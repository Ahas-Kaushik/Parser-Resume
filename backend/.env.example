# ========================================
# Fetch Ya Job - Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ----------------------------------------
# APPLICATION
# ----------------------------------------
APP_NAME=Fetch Ya Job
APP_VERSION=1.0.0
# FIX: Set to false in production!
DEBUG=false

# ----------------------------------------
# DATABASE
# ----------------------------------------
# Local SQLite (dev only):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL (production recommended):
# DATABASE_URL=postgresql://user:password@db-host:5432/fetchyajob

# ----------------------------------------
# SECURITY — REQUIRED
# ----------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# ----------------------------------------
# CORS — Set to your real frontend URL in production
# ----------------------------------------
ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173

# ----------------------------------------
# FILE UPLOADS
# ----------------------------------------
UPLOAD_DIR=./storage
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,docx,txt

# ----------------------------------------
# EMAIL (optional)
# ----------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fetchyajob.com

# ----------------------------------------
# AI/ML
# ----------------------------------------
AI_SCORING_ENABLED=true
DEFAULT_SCORE_THRESHOLD=70.0